PORT=4000
NODE_ENV=development

# CORS — the React dev server origin
FRONTEND_URL=http://localhost:5173

# Timeouts (milliseconds)
WHOIS_TIMEOUT_MS=8000
SSL_TIMEOUT_MS=10000
REDIRECT_TIMEOUT_MS=8000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

